#!/bin/sh
# Helper for /etc/polkit-1/rules.d/49-1password-cli.rules.
# Called by polkitd (as the unprivileged polkitd user) with the PID of the
# process the 1Password app wants authorized for CLI access.
#   exit 0  -> grant silently (process is outside any Claude Code session)
#   exit 1  -> fall back to the normal system-authentication prompt
# Every decision is logged to the journal (tag op-cli-authz) so the subject
# the app passes to polkit can be checked with:
#   journalctl -t op-cli-authz
pid="$1"
[ -n "$pid" ] || exit 1
cg="$(cat "/proc/$pid/cgroup" 2>/dev/null)" || exit 1
comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"
logger -t op-cli-authz "pid=$pid comm=$comm cgroup=${cg#0::}"
case "$cg" in
  */claude-*.scope*) exit 1 ;;
esac
exit 0
