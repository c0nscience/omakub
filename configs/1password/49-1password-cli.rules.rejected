// polkit rule: let the 1Password desktop app authorize the 1Password CLI
// without a system-authentication dialog, but only for CLI processes that
// are NOT running inside a Claude Code session (a claude-*.scope cgroup,
// created by the `claude` shell function in defaults/bash/functions).
//
// Why: the app binds a CLI authorization to the tty it came from and asks
// polkit for a fresh one per pane, so every `claude` launch through `op run`
// popped a dialog. The launch itself is a human action, so it is granted
// silently. An `op` call made from inside a session falls through to the
// stock policy (auth_self) and still prompts, keeping a human in the loop
// for anything an agent tries beyond its Deploy-only service account.
//
// The decision is delegated to /usr/local/libexec/op-cli-authz-check, which
// reads /proc/<pid>/cgroup of the requesting process. Any failure there
// (helper missing, pid gone, unexpected subject) falls back to the prompt.
polkit.addRule(function (action, subject) {
  if (action.id !== "com.1password.1Password.authorizeCLI") {
    return polkit.Result.NOT_HANDLED;
  }
  if (subject.user !== "benni") {
    return polkit.Result.NOT_HANDLED;
  }
  try {
    polkit.spawn(["/usr/local/libexec/op-cli-authz-check", "" + subject.pid]);
    return polkit.Result.YES;
  } catch (error) {
    return polkit.Result.NOT_HANDLED;
  }
});
