{
  "$schema": "https://opencode.ai/config.json",

  // Security-work profile: GLM 5.2 through OpenRouter, never Anthropic. Loaded
  // only by the `opencode-sec` shell function, which points OPENCODE_CONFIG at
  // this file - it is deliberately NOT installed to ~/.config/opencode so a
  // normal `opencode` run keeps its own global config and provider.
  //
  // opencode is provider-agnostic, which is the whole reason this exists: the
  // equivalent Claude Code wrapper had to be talked out of sending Anthropic-only
  // request fields and Anthropic server tools that OpenRouter cannot execute for
  // a non-Claude model, and was dropped for this. Here web access is opencode's
  // own client-side webfetch tool, so it runs against GLM instead of failing the
  // turn.
  //
  // No OpenRouter preset, deliberately. This used to request
  // z-ai/glm-5.2@preset/claude-sec, a preset carried over from the Claude Code
  // wrapper. A preset can hold OpenRouter *server tools* - web search, advisors,
  // subagents - and OpenRouter unions those into the request's tool array, so
  // every turn shipped a server tool opencode never registered and could not
  // answer. OpenRouter then killed sessions a few turns in with HTTP 400
  // `Server tool request failed` (metadata.provider_name null: the request never
  // reached a host). Routing lives here now, where it is visible, version
  // controlled, and cannot add tools behind opencode's back.
  "model": "openrouter/z-ai/glm-5.2",
  "small_model": "openrouter/z-ai/glm-5.2",

  "provider": {
    "openrouter": {
      // Resolved by `op run` at launch from ~/.config/op/opencode-sec.env, so
      // the key never lands on disk and never enters opencode's auth.json.
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2 · sec",
          "options": {
            // Endpoint allowlist replacing the pin the preset used to hold.
            // Every entry is an fp8 host serving the full 1M context with at
            // least 128k output and tool calling; novita keeps first place
            // because that is what the preset pinned. allow_fallbacks:false
            // stops OpenRouter routing to any other GLM 5.2 host, while the
            // list being longer than one means a single host answering
            // "Provider returned error" no longer ends the turn.
            // Re-check the hosts with:
            //   curl -s https://openrouter.ai/api/v1/models/z-ai/glm-5.2/endpoints
            "provider": {
              "order": ["novita/fp8", "z-ai/fp8", "baseten/fp8", "alibaba/fp8"],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },

  // A third-party model gets every mutating action approved by hand. Read-only
  // tools keep their defaults.
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "external_directory": "ask"
  }
}
