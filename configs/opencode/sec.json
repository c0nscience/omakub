{
  "$schema": "https://opencode.ai/config.json",

  // Security-work profile: GLM 5.2 through OpenRouter, never Anthropic. Loaded
  // only by the `opencode-sec` shell function, which points OPENCODE_CONFIG at
  // this file - it is deliberately NOT installed to ~/.config/opencode so a
  // normal `opencode` run keeps its own global config and provider.
  //
  // opencode is provider-agnostic, which is the whole reason this exists: the
  // equivalent Claude Code wrapper has to be talked out of sending Anthropic-only
  // request fields and Anthropic server tools that OpenRouter cannot execute for
  // a non-Claude model. Here websearch and webfetch are opencode's own
  // client-side tools, so they work against GLM instead of failing the turn.
  //
  // The @preset/claude-sec suffix resolves an OpenRouter preset that pins the
  // host to novita/fp8 (endpoint tag `novita/fp8`, 1M context / 128k output).
  // Change the pin on openrouter.ai, not here.
  "model": "openrouter/z-ai/glm-5.2@preset/claude-sec",
  "small_model": "openrouter/z-ai/glm-5.2@preset/claude-sec",

  "provider": {
    "openrouter": {
      // Resolved by `op run` at launch from ~/.config/op/opencode-sec.env, so
      // the key never lands on disk and never enters opencode's auth.json.
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2@preset/claude-sec": {
          "name": "GLM 5.2 · sec (novita/fp8)"
        }
      }
    }
  },

  // Same posture as claude-sec: a third-party model gets every mutating action
  // approved by hand. Read-only tools keep their defaults.
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "external_directory": "ask"
  }
}
